# Runtime secrets and state — never commit these.
# data/ holds the AES master key and the SQLite database with encrypted credentials.
asset-ops-prototype/data/
asset-ops-prototype/data-dev/
asset-ops-prototype/connector-dev/
*.db
*.db-wal
*.db-shm
master.key

# Packaged installers (rebuilt by package-qiyun.ps1 / package-connector.ps1).
asset-ops-prototype/dist/
asset-ops-prototype/downloads/*.zip

# Built binaries (rebuild with `go build ./cmd/qiyun`). Keep these patterns
# anchored: a bare "qiyun" would also match the cmd/qiyun source directory.
*.exe
/asset-ops-prototype/qiyun
/asset-ops-prototype/dbinspect

# QA evidence captured against the real environment: contains internal IPs,
# usernames, host-key fingerprints and session screenshots.
asset-ops-prototype/qa-evidence/

# Local Guacamole PoC deployment (contains lab database passwords).
guacamole-poc/

# Temporary render/check directories.
diagram-check-*/

# Stale binary backup left behind by a running executable.
*.exe~

# Local agent working notes.
.workbuddy/

# Editor and OS noise.
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Node test dependencies (jsdom for the DOM-level frontend tests).
node_modules/

# Local Go dependency vendor generated by `go mod vendor`. The frontend
# vendor/xterm and vendor/trzsz directories are tracked assets; `go mod vendor`
# deletes them, so restore with `git checkout -- vendor/xterm vendor/trzsz`.
asset-ops-prototype/vendor/github.com/
asset-ops-prototype/vendor/golang.org/
asset-ops-prototype/vendor/modernc.org/
asset-ops-prototype/vendor/modules.txt

# Local Go/npm caches and throwaway test databases.
.gocache/
.gotmp/
.npmcache/
.rdp-test-data/

# Logs.
*.log
# Rust agent build artifacts.
asset-ops-prototype/agent/qiyun-agent
asset-ops-prototype/agent/target/

# Generated Windows portable packages.
asset-ops-prototype/dist/
asset-ops-prototype/downloads/qiyun-agent-linux-amd64.zip

# Third-party reference clone used during RDP research; not part of this product.
asset-ops-prototype/web-vpn/

# Legacy terminal transfer binaries/reference tarball; the feature is offline.
asset-ops-prototype/tools/trz
asset-ops-prototype/tools/trzsz
asset-ops-prototype/tools/tsz
asset-ops-prototype/tools/trzsz_*.tar.gz

# Python bytecode from agent build/check helpers.
__pycache__/
*.pyc

# Local handoff/working notes, not product documentation.
asset-ops-prototype/AI_HANDOFF.md

# RDP lifecycle test artifacts.
asset-ops-prototype/internal/rdp/rdp-lifecycle-*/

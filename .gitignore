# Runtime secrets and state — never commit these.
# data/ holds the AES master key and the SQLite database with encrypted credentials.
asset-ops-prototype/data/
*.db
*.db-wal
*.db-shm
master.key

# Built binaries (rebuild with `go build ./cmd/qiyun`). Keep these patterns
# anchored: a bare "qiyun" would also match the cmd/qiyun source directory.
*.exe
/asset-ops-prototype/qiyun
/asset-ops-prototype/dbinspect

# QA evidence captured against the real environment: contains internal IPs,
# usernames, host-key fingerprints and session screenshots.
asset-ops-prototype/qa-evidence/

# Temporary render/check directories.
diagram-check-*/

# Stale binary backup left behind by a running executable.
*.exe~

# Local agent working notes.
.workbuddy/

# Editor and OS noise.
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Node test dependencies (jsdom for the DOM-level frontend tests).
node_modules/

# Logs.
*.log
